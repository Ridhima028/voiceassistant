DATABASE_URL=postgresql://postgres:admin123@db:5432/voicepilot

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Upload limits
MAX_UPLOAD_SIZE_MB=200
MAX_DURATION_MINUTES=90
QWEN_API_KEY=
QWEN_MODEL=qwen/qwen3-8b

# Celery broker / job queue
REDIS_URL=redis://redis:6379/0

# Object storage (MinIO locally, AWS S3 in prod — only these values change)
# Internal endpoint: what the backend/worker containers use to talk to MinIO.
S3_ENDPOINT_URL=http://minio:9000
# Public endpoint: used ONLY to sign presigned URLs the browser will open.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Dev: same as MINIO_ROOT_USER/PASSWORD in ../.env. In prod use a scoped access key.
S3_ACCESS_KEY=voicepilot
S3_SECRET_KEY=
S3_BUCKET=voicepilot-audio
S3_PRESIGNED_EXPIRY_SECONDS=900
